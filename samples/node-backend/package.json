{
  "name": "@giganexus/sample-node-backend",
  "version": "0.1.0",
  "private": true,
  "description": "GigaNexus 下游後端樣本(Node.js + Fastify):X-Internal-Token 驗證、OpenAPI(含說明與 Gherkin)、test / prod 啟動時自動註冊 API",
  "type": "module",
  "gateway": {
    "project": "node-backend"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix ../../sdk/node install --no-audit --no-fund && npm --prefix ../../sdk/node run build",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "openapi": "tsx src/print-openapi.ts",
    "gw:lookup": "node --env-file-if-exists=.env node_modules/@giganexus/backend-sdk/dist/lookup-cli.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.0",
    "@giganexus/backend-sdk": "file:../../sdk/node",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "jose": "^6.2.12",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
