# 複製為 .env(不入版控);部署區差異見 AGENT.md §2
# dev:本機開發,不自動註冊 / test:測試區 / prod:正式區(test、prod 啟動時自動註冊 API 為 Gateway 草稿)
GW_ENV=dev
SERVICE_CODE=node-sample
PORT=51201
# Gateway 位址(自動註冊、路由查詢、JWKS 皆經此);開發用自簽憑證以 NODE_EXTRA_CA_CERTS 指定根憑證
GW_BASE_URL=https://localhost
# NODE_EXTRA_CA_CERTS=../../deploy/dev/secrets/pki/ca.crt
# 選用,預設 {GW_BASE_URL}/.well-known/jwks.json
# GW_JWKS_URL=
# API Key:由 Gateway 負責人以 CLI client:create 建立;dev 可用 GW_API_KEY,test / prod 一律用 GW_API_KEY_FILE(Docker secret)
GW_API_KEY=
# GW_API_KEY_FILE=/run/secrets/gw_api_key
# Gateway 連到本服務的位址(test、prod 必填,port 需在 51200–51300)
# SERVICE_ADVERTISE_URL=http://<本機主機名稱>:51201
