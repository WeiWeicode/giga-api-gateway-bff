# 複製為 .env(不入版控);部署區差異見 AGENT.md §2
# dev:本機開發,不自動註冊 / test:測試區 / prod:正式區(test、prod 啟動時自動註冊 API 為 Gateway 草稿)
GW_ENV=dev
SERVICE_CODE=node-sample
PORT=51201
# Gateway 位址(自動註冊、路由查詢、JWKS 皆經此);公司測試區為主機 2 的 DNS 名稱(PRD Q1)
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# :443 為公開 CA(Sectigo)憑證,Node.js 預設即信任;仍使用臨時自簽憑證時才以 NODE_EXTRA_CA_CERTS 指定根憑證(向 Gateway 負責人取得 ca.crt)
# NODE_EXTRA_CA_CERTS=<ca.crt 路徑>
# 選用,預設 {GW_BASE_URL}/.well-known/jwks.json
# GW_JWKS_URL=
# API Key:由 Gateway 負責人以 CLI client:create 建立;dev 可用 GW_API_KEY,test / prod 一律用 GW_API_KEY_FILE(Docker secret)
GW_API_KEY=
# GW_API_KEY_FILE=/run/secrets/gw_api_key
# Gateway 連到本服務的位址(test、prod 必填,port 需在 51200–51300)
# SERVICE_ADVERTISE_URL=http://<本機主機名稱>:51201
# 監控(giga-observe,MONITORING-PLAN.md;各部署區各一套,不可跨區):dev 預設關閉,要在本機試送設 MONITOR_ENABLED=true
# MONITOR_URL=http://<giga-observe 主機>:5132
# MONITOR_API_KEY=                                  # dev 用;test / prod 一律用 MONITOR_API_KEY_FILE(Docker secret)
# MONITOR_API_KEY_FILE=/run/secrets/monitor_api_key
# MONITOR_ENABLED=true
