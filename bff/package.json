{
  "name": "@giganexus/bff",
  "version": "0.1.0",
  "private": true,
  "description": "GigaNexus Gateway — Nginx + Node.js BFF",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bff/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate --config ../drizzle.config.ts",
    "db:check-2012": "tsx scripts/check-sql2012.ts ../db/migrations",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:reset-test": "tsx --env-file-if-exists=.env scripts/reset-test-db.ts",
    "gw": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "gen:builtin": "tsx scripts/gen-builtin-routes.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "11.3.1",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.11",
    "drizzle-orm": "1.0.0-rc.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "find-my-way": "9.9.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "ldapts": "9.2.0",
    "mssql": "11.0.2",
    "nodemailer": "10.0.13",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "@types/mssql": "9.1.11",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "10.11.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "ws": "8.21.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
