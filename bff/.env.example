# 公司開發機設定(複製為 .env,不入版控):直接連公司 SQL Server 2012 測試庫(COMPANY-ENV-PLAN §1 M0:npm run test:int、db:migrate)
# 家中的本機模擬環境(deploy/dev/、docker-compose.dev.yml)不在公司使用;測試區 / 正式區不使用 .env:機密以 Docker secret 檔案注入(變數名稱加 _FILE,見 bff/src/config.ts)
# 密碼向 DBA 取得,只填在自己電腦的 .env,不要寫回本範本

NODE_ENV=development
LOG_LEVEL=debug
PORT=3100

# giganexus_gw(SQL Server 2012,內網不加密;伺服器網段 10.10.130.x)
GW_DB_HOST=<SQL Server 2012 主機 IP>
GW_DB_PORT=1433
# db:migrate、db:seed、npm run dev 使用;與測試區(主機 2)是同一個資料庫,寫入的資料測試區看得到
GW_DB_NAME=giganexus_gw_test
GW_DB_USER=gw_app
GW_DB_PASSWORD=
# migration 專用帳號(DDL 權限)
GW_MIGRATE_USER=gw_migrate
GW_MIGRATE_PASSWORD=

# 整合測試專用庫(P-04):npm run test:int 會先刪除此庫 schema gw 的所有資料表再重建(名稱須含 _test)
# 測試區上線前可暫用 giganexus_gw_test 做 M0 複驗;測試區上線後必須改用 DBA 另建的專用庫,否則會清空測試區的路由、權限與使用者
GW_TEST_DB_NAME=<整合測試專用庫>

# 以下唯讀來源未提供時保持註解(*_HOST 未設定即不連線;人員同步與舊帳號遷移尚未實作)
# LOS(SQL Server 2012,唯讀,不加密)
# LOS_DB_HOST=10.10.130.220
# LOS_DB_NAME=LOS
# LOS_DB_USER=los_reader
# LOS_DB_PASSWORD=

# BPM(SQL Server 2019,唯讀,加密連線;憑證不是企業根 CA 簽發時才設 BPM_DB_TRUST_SERVER_CERT=true)
# BPM_DB_HOST=10.10.130.190
# BPM_DB_NAME=NaNa
# BPM_DB_USER=bpm_reader
# BPM_DB_PASSWORD=

# 舊單一入口(SQL Server 2012,唯讀,不加密)
# PORTAL_DB_HOST=10.10.130.220
# PORTAL_DB_NAME=PortalSolar
# PORTAL_DB_USER=portal_reader
# PORTAL_DB_PASSWORD=

# npm run dev 需要 Redis(整合測試不需要):docker run -d --name gw-redis -p 127.0.0.1:16379:6379 redis:7-alpine
REDIS_URL=redis://localhost:16379

# 開發 / 測試時檢查執行期 SQL 是否含 2012 不支援的語法(warn / error / off)
SQL2012_GUARD=error

# JWT ES256 金鑰目錄(<kid>.pem;npm run dev 需要,整合測試不讀取)。在 bff/ 下以 Git Bash 產生(secrets/ 不入版控):
#   mkdir -p secrets/jwt && openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out secrets/jwt/dev-$(date +%Y%m).pem
JWT_KEYS_DIR=./secrets/jwt
# 公司 AD 登入:只使用 gsmc(碩禾_新);gsc 舊網域與 ygdmc 鹽城碩禾不再使用(2026-09-30)。未設定 LDAP_DOMAINS_FILE 時不提供 AD 登入。
#   1. cp ldap-domains.example.json secrets/ldap-domains.json(非機密:DC 位址、baseDN、服務帳號 UPN;值沿用 GeneralBackend 已驗證設定)
#   2. 取消下列註解並填入各網域服務帳號密碼。JSON 列出的每個網域都必須有密碼,否則 BFF 啟動失敗
# 過渡期使用 ldap://(未加密,PRD Q12);系統工程師完成 LDAPS 後只需把 JSON 的 url 改為 ldaps://<DC>:636
# LDAP_DOMAINS_FILE=./secrets/ldap-domains.json
# LDAP_GSMC_BIND_PASSWORD=
# 測試用 AD 帳號、本機帳號的密碼不放 .env(程式不讀取):AD 帳號直接在登入頁測試;
# 本機帳號以 `npm run gw -- local:create --emp <工號> --base-url http://localhost:3100` 產生啟用連結,於連結頁設定密碼
COOKIE_SECURE=true

# Webhook 密鑰目錄(檔名 = gw.webhook_endpoint.secret_ref,BACKEND-GUIDE §7.6;secrets/ 不入版控):
#   mkdir -p secrets/webhook && openssl rand -hex 32 > secrets/webhook/bpm
WEBHOOK_SECRETS_DIR=./secrets/webhook
