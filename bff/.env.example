# 本機開發設定(複製為 .env;值對應 deploy/docker-compose.dev.yml 的預設值)
# 測試區 / 正式區不使用 .env:機密以 Docker secret 檔案注入(變數名稱加 _FILE,見 bff/src/config.ts)

NODE_ENV=development
LOG_LEVEL=debug
PORT=3100

# giganexus_gw(SQL Server 2012,內網不加密)
GW_DB_HOST=localhost
GW_DB_PORT=1433
GW_DB_NAME=giganexus_gw
GW_DB_USER=gw_app
GW_DB_PASSWORD=GwApp_Passw0rd!
# migration 專用帳號(DDL 權限)
GW_MIGRATE_USER=gw_migrate
GW_MIGRATE_PASSWORD=GwMigrate_Passw0rd!

# 整合測試專用庫(P-04)
GW_TEST_DB_NAME=giganexus_gw_test

# LOS(SQL Server 2012,唯讀,不加密)
LOS_DB_HOST=localhost
LOS_DB_PORT=1433
LOS_DB_NAME=LOS
LOS_DB_USER=los_reader
LOS_DB_PASSWORD=LosReader_Passw0rd!

# BPM(SQL Server 2019,唯讀,加密連線;本機容器為自簽憑證)
BPM_DB_HOST=localhost
BPM_DB_PORT=1433
BPM_DB_NAME=BPM
BPM_DB_USER=bpm_reader
BPM_DB_PASSWORD=BpmReader_Passw0rd!
BPM_DB_TRUST_SERVER_CERT=true

# 舊單一入口(SQL Server 2012,唯讀,不加密)
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=1433
PORTAL_DB_NAME=PortalSolar
PORTAL_DB_USER=portal_reader
PORTAL_DB_PASSWORD=PortalReader_Passw0rd!

REDIS_URL=redis://localhost:16379

# 開發 / 測試時檢查執行期 SQL 是否含 2012 不支援的語法(warn / error / off)
SQL2012_GUARD=error

# JWT ES256 金鑰目錄(<kid>.pem);本機由 deploy/dev/gen-dev-secrets.sh 產生
JWT_KEYS_DIR=../deploy/dev/secrets/jwt
# 本機在 Docker 外執行 BFF 時不設定 LDAP_DOMAINS_FILE(AD 登入請使用 deploy/dev/up.sh 的完整環境)
COOKIE_SECURE=true
